<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Codex Rescue — Technician Health Dashboard"
    Width="1200"
    Height="740"
    MinWidth="1024"
    MinHeight="680"
    WindowStartupLocation="CenterScreen"
    Background="#D9D9D9"
    FontFamily="Atkinson Hyperlegible, Segoe UI"
    TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <SolidColorBrush x:Key="TextPrimary" Color="#1E1E1E" />
    <SolidColorBrush x:Key="TextSecondary" Color="#525252" />
    <SolidColorBrush x:Key="TextInverse" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderDefault" Color="#B3B3B3" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceMuted" Color="#F5F5F5" />
    <SolidColorBrush x:Key="SurfaceStrong" Color="#E6E6E6" />
    <SolidColorBrush x:Key="Brand" Color="#2C2C2C" />
    <FontFamily x:Key="MonoFont">IBM Plex Mono, Consolas</FontFamily>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Surface}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="MetaText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="NavigationItem" TargetType="Border">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Background" Value="{StaticResource SurfaceStrong}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <DataTemplate x:Key="HealthCardTemplate">
      <Border
          Margin="0,0,0,12"
          Padding="18"
          CornerRadius="9"
          Background="{Binding StatusBackground}"
          BorderBrush="{Binding StatusBorder}"
          BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Text="{Binding Title}"
                FontSize="17"
                FontWeight="Bold"
                VerticalAlignment="Center" />
            <Border
                Grid.Column="1"
                Margin="12,0,0,0"
                Padding="9,4"
                CornerRadius="12"
                Background="{Binding BadgeBackground}"
                BorderBrush="{Binding StatusBorder}"
                BorderThickness="1">
              <TextBlock
                  Text="{Binding StatusLabel}"
                  Foreground="{Binding StatusForeground}"
                  FontFamily="{StaticResource MonoFont}"
                  FontSize="11"
                  FontWeight="Bold" />
            </Border>
          </Grid>
          <TextBlock
              Grid.Row="1"
              Margin="0,10,0,10"
              Text="{Binding Summary}"
              FontSize="14"
              LineHeight="21"
              TextWrapping="Wrap" />
          <TextBlock
              Grid.Row="2"
              Text="{Binding EvidenceMetadata}"
              Style="{StaticResource MetaText}" />
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="72" />
      <RowDefinition Height="*" />
      <RowDefinition Height="34" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="0,0,0,1">
      <Grid Margin="24,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="38" Height="38" CornerRadius="8" Background="{StaticResource Brand}">
            <TextBlock Text="CR" Foreground="{StaticResource TextInverse}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Codex Rescue" FontSize="19" FontWeight="Bold" />
            <TextBlock Text="Windows 11 technician health dashboard" FontSize="12" Foreground="{StaticResource TextSecondary}" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Padding="10,5" CornerRadius="13" Background="#FEE9E7" BorderBrush="#900B09" BorderThickness="1" Margin="0,0,8,0">
            <TextBlock Text="READ ONLY" Foreground="#900B09" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" />
          </Border>
          <Border Padding="10,5" CornerRadius="13" Background="#E3E3E3" BorderBrush="#767676" BorderThickness="1" Margin="0,0,8,0">
            <TextBlock Text="{Binding NetworkStateBadge}" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" />
          </Border>
          <Border Padding="10,5" CornerRadius="13" Background="#E3E3E3" BorderBrush="#767676" BorderThickness="1">
            <TextBlock Text="{Binding CloudStateBadge}" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" />
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="185" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="360" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="12">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="WORKSPACE" Style="{StaticResource MetaText}" Margin="8,4,0,12" />
            <Border Style="{StaticResource NavigationItem}" Background="{StaticResource Brand}">
              <TextBlock Text="Device health" Foreground="{StaticResource TextInverse}" FontWeight="Bold" />
            </Border>
            <Border Style="{StaticResource NavigationItem}"><TextBlock Text="Evidence" /></Border>
            <Border Style="{StaticResource NavigationItem}"><TextBlock Text="Audit timeline" /></Border>
            <Border Style="{StaticResource NavigationItem}"><TextBlock Text="Codex handoff" /></Border>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
            <Border Background="{StaticResource SurfaceMuted}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1" CornerRadius="7" Padding="12">
              <StackPanel>
                <TextBlock Text="Assessment boundary" FontWeight="Bold" Margin="0,0,0,6" />
                <TextBlock Text="Local data stays on this device. Nothing is sent to Codex automatically." FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="18" />
              </StackPanel>
            </Border>
          </StackPanel>
        </DockPanel>
      </Border>

      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Border Style="{StaticResource Panel}" Margin="0,0,0,14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Device health" FontSize="28" FontWeight="Bold" />
                <TextBlock Text="{Binding HealthSummary}" FontSize="14" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="24,0,0,0">
                <TextBlock Text="{Binding HealthScoreText}" FontSize="34" FontWeight="Bold" HorizontalAlignment="Right" />
                <TextBlock Text="LOCAL SCORE" Style="{StaticResource MetaText}" HorizontalAlignment="Right" />
              </StackPanel>
            </Grid>
          </Border>

          <ItemsControl ItemsSource="{Binding CheckCards}" ItemTemplate="{StaticResource HealthCardTemplate}" />
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Border Style="{StaticResource Panel}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Local device" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="{Binding DeviceSummaryText}" FontSize="13" TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,12" />
              <TextBlock Text="Installed Windows" Style="{StaticResource SectionTitle}" Margin="0,4,0,0" />
              <TextBlock Text="{Binding InstalledWindowsSummaryText}" FontSize="13" TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,0" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Panel}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Safety boundary" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="This dashboard only displays a validated Phase 1 assessment. It cannot unlock BitLocker, repair Windows, authenticate to Graph, or run commands through Codex." FontSize="13" TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,10" />
              <TextBlock Text="APPROVAL GATE CLOSED" Foreground="#900B09" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Panel}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Evidence and reports" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="{Binding EvidenceSummaryText}" FontSize="13" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,12" />
              <Button x:Name="OpenDetailedReportButton" Content="Open detailed local report" Style="{StaticResource SecondaryButton}" IsEnabled="{Binding DetailedReportAvailable}" Margin="0,0,0,8" />
              <Button x:Name="ShowSanitizedZipButton" Content="Show sanitized escalation ZIP" Style="{StaticResource SecondaryButton}" IsEnabled="{Binding SanitizedZipAvailable}" />
              <TextBlock Text="{Binding ArtifactAvailabilityText}" Style="{StaticResource MetaText}" Margin="0,10,0,0" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Panel}">
            <StackPanel>
              <TextBlock Text="Local audit timeline" Style="{StaticResource SectionTitle}" />
              <ItemsControl ItemsSource="{Binding TimelineEntries}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#2C2C2C" VerticalAlignment="Top" Margin="0,5,0,0" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Metadata}" Style="{StaticResource MetaText}" Margin="0,3,0,0" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="0,1,0,0">
      <Grid Margin="20,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding AssessmentFooterText}" VerticalAlignment="Center" Style="{StaticResource MetaText}" />
        <TextBlock Grid.Column="1" Text="No automatic upload • No repair controls" VerticalAlignment="Center" Style="{StaticResource MetaText}" />
      </Grid>
    </Border>
  </Grid>
</Window>
