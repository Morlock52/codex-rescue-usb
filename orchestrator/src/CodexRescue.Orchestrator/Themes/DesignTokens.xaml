<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
  <FontFamily x:Key="InterfaceFont">Atkinson Hyperlegible, Segoe UI</FontFamily>
  <FontFamily x:Key="MonoFont">IBM Plex Mono, Cascadia Mono</FontFamily>

  <Color x:Key="CanvasColor">#FFF4F4F1</Color>
  <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
  <Color x:Key="SurfaceMutedColor">#FFE8E9E5</Color>
  <Color x:Key="TextPrimaryColor">#FF171A18</Color>
  <Color x:Key="TextSecondaryColor">#FF5F655F</Color>
  <Color x:Key="ActionPrimaryColor">#FF17382D</Color>
  <Color x:Key="PositiveColor">#FF207A53</Color>
  <Color x:Key="WarningColor">#FFB16B18</Color>
  <Color x:Key="DangerColor">#FFB33B31</Color>
  <Color x:Key="FocusRingColor">#FF1264A3</Color>

  <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceMutedBrush" Color="{StaticResource SurfaceMutedColor}" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="ActionPrimaryBrush" Color="{StaticResource ActionPrimaryColor}" />
  <SolidColorBrush x:Key="PositiveBrush" Color="{StaticResource PositiveColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="FocusRingBrush" Color="{StaticResource FocusRingColor}" />
  <system:Double x:Key="MinimumTargetSize">44</system:Double>

  <Style x:Key="WorkflowCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="#FFD5D8D2" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="22" />
    <Setter Property="Margin" Value="0,0,14,14" />
  </Style>
  <Style x:Key="CardTitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style x:Key="CardBodyStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,8,0,0" />
  </Style>
  <Style x:Key="MonoStatusStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Margin" Value="0,14,0,0" />
  </Style>
  <Style x:Key="PageIntroStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,8,0,26" />
  </Style>

  <Style TargetType="Window">
    <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="Background" Value="{StaticResource CanvasBrush}" />
  </Style>
  <Style TargetType="Button">
    <Setter Property="MinHeight" Value="{StaticResource MinimumTargetSize}" />
    <Setter Property="Padding" Value="18,8" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FocusVisualStyle">
      <Setter.Value>
        <Style TargetType="Control">
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate>
                <Border BorderBrush="{StaticResource FocusRingBrush}"
                        BorderThickness="3" CornerRadius="6" />
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
